# Copy this file to .env and fill in whichever keys you have.
# Any source left blank is simply skipped in the report — nothing breaks.

# https://newsapi.org (free tier: 100 requests/day, developer use only)
NEWSAPI_KEY=

# https://gnews.io (free tier: 100 requests/day)
GNEWS_KEY=

# https://developer.twitter.com — GET /1.1/trends/place needs a PAID tier
# (Basic or higher). Not available on the free tier as of 2024+.
TWITTER_BEARER_TOKEN=
